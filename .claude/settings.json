{
  "permissions": {
    "allow": [
      "Bash(python3 tools/wiki.py:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 tools/wiki.py status" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "python3 tools/wiki.py hook post-write" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 tools/wiki.py hook stop" } ] }
    ]
  }
}
